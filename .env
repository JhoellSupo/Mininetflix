# ========================================================
# MiniNetflix - Configuración de Credenciales
# ========================================================

# 1. Base de Datos (AWS RDS MySQL)
DB_CONNECTION=mysql
DB_HOST=mininetflix-db.cbe8sc60m6b6.us-east-2.rds.amazonaws.com
DB_PORT=3306
DB_NAME=mininetflix
DB_USER=admin
DB_PASS=ventilador

# 2. Amazon Web Services (AWS S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_BUCKET=mininetflix-media-bucket

# Tiempo de expiración de las URLs de video en segundos (3600 = 1 hora)
S3_PRESIGNED_EXPIRY=3600
