# ========================================================
# MiniNetflix - Configuración de Entorno
# ========================================================

# Base de Datos (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mininetflix
DB_USER=root
DB_PASS=

# Amazon Web Services (AWS S3)
# Ingrese aquí sus credenciales de IAM con permisos en el bucket S3:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=mininetflix-media-bucket

# Tiempo de expiración de las URLs prefirmadas en segundos (ej. 3600 = 1 hora)
S3_PRESIGNED_EXPIRY=3600

# Clave de seguridad para tokens firmados locales
APP_SECRET_KEY=mininetflix_super_secret_sigv4_token_2026
